# ---------------------------------------------------------------------------
# Hacker-Do CyberPulse — environment
# ---------------------------------------------------------------------------

# REQUIRED. Encrypts AI keys, webhook URLs and 2FA seeds at rest (AES-256-GCM).
# Generate with: openssl rand -hex 32   — back it up: without it those secrets
# cannot be decrypted.
CYBERPULSE_SECRET=

# First superadmin, created on first start only. Remove the password afterwards.
# (Alternative: docker exec -it cyberpulse npx tsx server/cli.ts create-superadmin <user>)
CYBERPULSE_ADMIN_USERNAME=
CYBERPULSE_ADMIN_PASSWORD=

# Behind a reverse proxy (Traefik, Cloudflare Tunnel): number of trusted hops.
# Needed for correct client IPs in rate limiting and Secure cookies.
# TRUST_PROXY=1

# Served over plain http (e.g. http://192.168.0.x:3001 on a LAN): set to true,
# otherwise browsers upgrade asset requests to https and the page is blank.
# CYBERPULSE_PLAIN_HTTP=true
# Force the Secure flag on the session cookie (default: follows the request).
# CYBERPULSE_COOKIE_SECURE=true

# Session lifetime in hours (default 12).
# CYBERPULSE_SESSION_HOURS=12

# Rocket.Chat on a private network (10.x, 192.168.x...) needs this; Slack never does.
# CYBERPULSE_ALLOW_PRIVATE_WEBHOOKS=false
# CYBERPULSE_ALLOW_HTTP_WEBHOOKS=false

# Extra OpenAI-compatible API hosts companies may use (comma separated).
# CYBERPULSE_AI_HOSTS=

# Optional: enables the read-only MCP endpoint (/api/mcp) for AI agents.
# CYBERPULSE_API_KEY=

# RSS scrape schedule (cron).
SCRAPE_CRON=*/15 * * * *

# ---------------------------------------------------------------------------
# LinkedIn (optional). App(s) at https://www.linkedin.com/developers/apps with
# redirect URL https://<your-domain>/api/linkedin/callback
# ---------------------------------------------------------------------------
# LINKEDIN_REDIRECT_URI=https://cyberpulse.example.com/api/linkedin/callback
# Personal posting: "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn".
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# Company Pages: a second app with only "Community Management API" (LinkedIn
# does not allow it next to the products above in the same app).
# LINKEDIN_PAGES_CLIENT_ID=
# LINKEDIN_PAGES_CLIENT_SECRET=
# One app with every product: also request the Company Pages permissions.
# LINKEDIN_ORG_POSTING=1
# Advanced overrides (space or comma separated scopes; API version YYYYMM).
# LINKEDIN_SCOPES=
# LINKEDIN_PAGES_SCOPES=
# LINKEDIN_API_VERSION=202609

# ---------------------------------------------------------------------------
# Tuning (defaults shown)
# ---------------------------------------------------------------------------
# Extra origins allowed by CORS (comma separated); the bundled UI never needs it.
# CYBERPULSE_CORS_ORIGINS=
# Requests per IP: reads, writes and manual sends per minute; logins per 15 minutes.
# CYBERPULSE_RATE_READ=300
# CYBERPULSE_RATE_WRITE=60
# CYBERPULSE_RATE_SEND=10
# CYBERPULSE_RATE_LOGIN=20
# Max articles returned to the UI, and feeds fetched in parallel.
# CYBERPULSE_MAX_NEWS=20000
# CYBERPULSE_SCRAPE_CONCURRENCY=8
